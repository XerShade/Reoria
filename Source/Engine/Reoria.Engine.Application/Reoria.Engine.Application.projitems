<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>76cf7146-64a3-4d1a-b60e-3cbe3c1e4cb5</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Reoria.Engine.Application</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)AppBootStrapper.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Configuration\AppConfigurationBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Configuration\Interfaces\IAppConfigurationBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Interfaces\IApplication.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Modules\IApplicationInjectors.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Modules\IBootStrapInjectors.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Services\FileProviderService.cs" />
