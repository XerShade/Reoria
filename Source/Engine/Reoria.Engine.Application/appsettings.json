{
  "Logging": {
    "LogLevel": { "Default": "Information" }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": { "Default": "Information" },
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Networking": {
    "Address": "127.0.0.1",
    "Port": "7234",
    "Timeout": "5",
    "ConnectionKey": "Reoria"
  }
}
